---
// Redesign v2 — dark pine-green homepage. Ported from the Claude Design file
// "Forward Army Redesign v2.dc.html": DC templating (sc-for/sc-if/{{}}) converted
// to Astro, <image-slot> mapped to the founder photo/monogram pattern,
// style-hover -> scoped CSS, plus responsive stacking. Departs from DESIGN.md by
// explicit request; kept self-contained (own nav/footer) so the theme is isolated.
import Base from '../layouts/Base.astro';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

const DISPLAY = "'Space Grotesk Variable', 'Space Grotesk', sans-serif";
const SANS = "'IBM Plex Sans Variable', 'IBM Plex Sans', Helvetica, sans-serif";
const MONO = "'IBM Plex Mono', ui-monospace, monospace";

const title = 'forward.army — Custom AI agents that do real work. Under your command.';
const description =
  'Each forward-deployed agent is engineered for one job, wired into your tools, run on your infrastructure — and nothing risky ships without your approval.';

// photo: drop a portrait in public/team/<file> and set the path to replace the monogram.
const founders = [
  { name: 'Łukasz Augustyniak', role: 'CO-FOUNDER · NLP RESEARCH', photo: null, bio: 'NLP researcher focused on LLMs and AI for legal work. Published across sentiment analysis, aspect extraction, and speech-recognition evaluation.', scholar: 'https://scholar.google.com/citations?user=o3apDSYAAAAJ&hl=en', linkedin: 'https://www.linkedin.com/in/lukaszaugustyniak/' },
  { name: 'Roman Bartusiak', role: 'CO-FOUNDER · ML ENGINEERING', photo: null, bio: 'ML engineer and researcher in NLP. Full-stack software professional with deep expertise in distributed systems and applied AI.', scholar: 'https://scholar.google.com/citations?user=mk68epwAAAAJ&hl=en', linkedin: 'https://www.linkedin.com/in/romanbartusiak/' },
  { name: 'Adrian Szymczak', role: 'CO-FOUNDER · AI ARCHITECTURE', photo: null, bio: 'AI solutions architect across LLMs, data science, and software engineering. Published on conversational-speech modeling and ASR-error robustness.', scholar: 'https://scholar.google.com/citations?user=fNqZL_4AAAAJ&hl=en', linkedin: 'https://www.linkedin.com/in/adrianszymczak/' },
];

const hows = [
  { num: '01', title: 'Your ground, or ours', body: 'Run the agent and its models on your infrastructure — up to fully air-gapped — or in a dedicated, isolated account on our platform. Either way, you own where it runs.' },
  { num: '02', title: 'Deterministic where possible', body: 'Wherever a step can be code instead of a model call, it is. That lifts success rates, makes it testable, and shrinks the model’s degrees of freedom.' },
  { num: '03', title: 'Connected to your tools', body: 'Plugs into your knowledge bases, tickets, and repos — and asks explicitly when it needs access it doesn’t have.' },
  { num: '04', title: 'Multi-model guardrails', body: 'Layered checks review every action for correctness and failure modes — not a single model marking its own homework.' },
  { num: '05', title: 'Everything ships as PRs', body: 'Changes arrive as pull requests against your codebase, or as approvals inside our platform if you have no infrastructure-as-code.' },
];

const faqs = [
  { q: 'What can an agent actually touch?', a: 'Only what you grant. Every capability is explicitly scoped and bounded — the same badge-and-scope you’d give a trusted contractor.' },
  { q: 'How do I stop it?', a: 'One click. Revoke access and the agent is gone instantly — no cleanup, no residue.' },
  { q: 'Does our data ever leave our environment?', a: 'Not unless you want it to. Run everything on-premise and air-gapped, or in a dedicated isolated account — never shared.' },
  { q: 'Do we need engineers to run this?', a: 'No. Our engineers help you build and deploy it. You bring a real problem and decide what ships.' },
];
---
<Base title={title} description={description}>
  <div class="dsx-root" style={`font-family: ${SANS}; color: #e8eee9; font-size: 16px; line-height: 1.55; background: #0f1712;`}>

    <!-- NAV -->
    <nav class="dsx-pad" style="position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; padding: 14px 40px; background: rgba(15,23,18,0.88); backdrop-filter: blur(12px); border-bottom: 1px solid #1f2c24;">
      <div style={`font-family: ${DISPLAY}; font-weight: 700; font-size: 17px; letter-spacing: -0.02em;`}>forward<span style="color: #2f9e69;">.army</span></div>
      <div class="dsx-navlinks" style="display: flex; align-items: center; gap: 28px; font-size: 14px; font-weight: 500;">
        <a href="#team" class="dsx-navlink" style="color: #9fb0a5;">Team</a>
        <a href="#loop" class="dsx-navlink" style="color: #9fb0a5;">The loop</a>
        <a href="#how" class="dsx-navlink" style="color: #9fb0a5;">How it works</a>
        <a href="#faq" class="dsx-navlink" style="color: #9fb0a5;">Questions</a>
      </div>
      <a href="#cta" class="dsx-navcta" style="background: #2f9e69; color: #08130c; padding: 9px 18px; border-radius: 6px; font-weight: 600; font-size: 14px;">Request access</a>
    </nav>

    <main id="main">
    <!-- HERO -->
    <header class="dsx-pad" style="padding: 88px 40px 64px; border-bottom: 1px solid #1f2c24; background: radial-gradient(900px 500px at 75% -10%, #16241c 0%, #0f1712 60%);">
      <div class="dsx-hero-grid" style="max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 64px; align-items: center;">
        <div>
          <div style={`display: inline-flex; align-items: center; gap: 8px; font-family: ${MONO}; font-size: 12px; color: #8fb8a2; border: 1px solid #2b3a31; border-radius: 999px; padding: 6px 14px; margin-bottom: 28px;`}>
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #4ade80; display: inline-block;"></span>
            Accepting new deployments
          </div>
          <h1 style={`font-family: ${DISPLAY}; font-size: 56px; line-height: 1.05; letter-spacing: -0.03em; font-weight: 700; margin: 0 0 20px; text-wrap: balance;`}>Custom AI agents that do real work. Under your command.</h1>
          <p style="font-size: 18px; color: #9fb0a5; max-width: 480px; margin: 0 0 32px; text-wrap: pretty;">Each agent is engineered for one job, wired into your tools, run on your infrastructure — and nothing risky ships without your approval.</p>
          <div style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
            <a href="#cta" class="dsx-btn" style="background: #2f9e69; color: #08130c; padding: 13px 26px; border-radius: 7px; font-weight: 600; font-size: 15px;">Request access</a>
            <a href="#loop" class="dsx-btn-ghost" style="color: #cfdad3; padding: 13px 22px; border-radius: 7px; border: 1px solid #2b3a31; font-weight: 500; font-size: 15px;">See how it works</a>
          </div>
        </div>
        <div style={`background: #0b110d; border: 1px solid #26332b; border-radius: 12px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,0.5); font-family: ${MONO}; font-size: 12.5px;`}>
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; border-bottom: 1px solid #26332b; color: #6e8377;">
            <span>agent/invoice-ops — activity</span>
            <span style="color: #4ade80;">● live</span>
          </div>
          <div class="dsx-feed" style="padding: 18px; display: flex; flex-direction: column; gap: 12px; line-height: 1.5;">
            <div style="animation: dsxfeedIn 0.4s ease both;"><span style="color: #57695f;">09:41</span> <span style="color: #8fb8a2;">inspect</span> <span style="color: #c4cec8;">read 214 invoices from NetSuite · flagged 3 mismatches</span></div>
            <div style="animation: dsxfeedIn 0.4s 0.15s ease both;"><span style="color: #57695f;">09:44</span> <span style="color: #e2b45a;">propose</span> <span style="color: #c4cec8;">brief #128 — reconcile vendor duplicates, est. 2h saved/wk</span></div>
            <div style="animation: dsxfeedIn 0.4s 0.3s ease both; display: flex; align-items: center; gap: 10px; background: #16241c; border: 1px solid #2b3a31; border-radius: 8px; padding: 10px 14px;">
              <span style="color: #e2b45a;">⏸ awaiting your approval</span>
              <span style="margin-left: auto; background: #2f9e69; color: #08130c; padding: 3px 10px; border-radius: 5px; font-weight: 500;">Approve</span>
              <span style="border: 1px solid #3a4a40; color: #9fada4; padding: 3px 10px; border-radius: 5px;">Decline</span>
            </div>
            <div style="animation: dsxfeedIn 0.4s 0.45s ease both;"><span style="color: #57695f;">09:52</span> <span style="color: #6ea8ff;">implement</span> <span style="color: #c4cec8;">PR #412 opened — every action logged</span></div>
            <div style="color: #57695f;">▮<span class="dsx-blink">&nbsp;</span></div>
          </div>
        </div>
      </div>
      <!-- STAT STRIP -->
      <div class="dsx-stat-strip" style="max-width: 1160px; margin: 64px auto 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: #26332b; border: 1px solid #26332b; border-radius: 10px; overflow: hidden;">
        <div style="background: #131e17; padding: 20px 24px;"><div style={`font-family: ${DISPLAY}; font-size: 26px; font-weight: 700;`}>820+</div><div style="font-size: 13px; color: #8a988f;">peer-reviewed citations</div></div>
        <div style="background: #131e17; padding: 20px 24px;"><div style={`font-family: ${DISPLAY}; font-size: 26px; font-weight: 700;`}>NeurIPS · ACL</div><div style="font-size: 13px; color: #8a988f;">published at top venues</div></div>
        <div style="background: #131e17; padding: 20px 24px;"><div style={`font-family: ${DISPLAY}; font-size: 26px; font-weight: 700;`}>On-prem</div><div style="font-size: 13px; color: #8a988f;">up to fully air-gapped</div></div>
        <div style="background: #131e17; padding: 20px 24px;"><div style={`font-family: ${DISPLAY}; font-size: 26px; font-weight: 700;`}>1-click</div><div style="font-size: 13px; color: #8a988f;">revocable access</div></div>
      </div>
    </header>

    <!-- TEAM -->
    <section id="team" class="dsx-pad" style="padding: 96px 40px; border-bottom: 1px solid #1f2c24;">
      <div style="max-width: 1160px; margin: 0 auto;">
        <div style={`font-family: ${MONO}; font-size: 12px; color: #57c78f; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 12px;`}>02 / The team</div>
        <div class="dsx-team-head" style="display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: end; margin-bottom: 48px;">
          <h2 style={`font-family: ${DISPLAY}; font-size: 42px; letter-spacing: -0.02em; font-weight: 700; margin: 0; text-wrap: balance;`}>Built by the people who wrote the research.</h2>
          <p style="color: #9fb0a5; margin: 0;">Every agent is designed, governed, and backed by founders with careers at the frontier of NLP research and large-scale software — 820+ citations, publishing since 2014.</p>
        </div>
        <div class="dsx-team-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
          {founders.map((f) => (
            <div class="dsx-teamcard" style="background: #131e17; border: 1px solid #26332b; border-radius: 12px; padding: 28px; display: flex; flex-direction: column; gap: 18px;">
              <div style="width: 96px; height: 96px; border-radius: 50%; overflow: hidden; background: #0b110d; border: 1px solid #26332b; display: flex; align-items: center; justify-content: center; flex: none;">
                {f.photo ? (
                  <img src={f.photo} alt={`${f.name}, forward.army co-founder`} width="96" height="96" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(1);" />
                ) : (
                  <span aria-hidden="true" style={`font-family: ${DISPLAY}; font-weight: 700; font-size: 26px; color: #4a5f53;`}>{f.name.split(' ').map((w) => w[0]).join('')}</span>
                )}
              </div>
              <div>
                <h3 style={`font-family: ${DISPLAY}; font-size: 20px; margin: 0 0 6px;`}>{f.name}</h3>
                <div style={`font-family: ${MONO}; font-size: 12px; color: #8fb8a2; margin-bottom: 10px;`}>{f.role}</div>
                <p style="margin: 0; font-size: 14px; color: #9fb0a5;">{f.bio}</p>
              </div>
              <div style="display: flex; gap: 14px; font-size: 13.5px; font-weight: 500; margin-top: auto;">
                <a href={f.scholar} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a>
                <a href={f.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- THE LOOP -->
    <section id="loop" class="dsx-pad" style="padding: 96px 40px; border-bottom: 1px solid #1f2c24; background: #0b110d;">
      <div style="max-width: 1160px; margin: 0 auto;">
        <div style={`font-family: ${MONO}; font-size: 12px; color: #57c78f; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 12px;`}>03 / The loop</div>
        <h2 style={`font-family: ${DISPLAY}; font-size: 42px; letter-spacing: -0.02em; font-weight: 700; margin: 0 0 12px;`}>Inspect. Propose. Implement.</h2>
        <p style="color: #9fb0a5; max-width: 560px; margin: 0 0 56px;">The loop a good hire runs in their first month — as supervised autonomy.</p>
        <div class="dsx-loop" style="display: grid; grid-template-columns: 1fr 56px 1fr 56px 1fr; align-items: stretch; gap: 0; margin-bottom: 20px;">
          <div style="background: #131e17; border: 1px solid #2b3a31; border-radius: 12px; padding: 28px;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
              <span style="width: 10px; height: 10px; background: #8fb8a2; border-radius: 2px; display: inline-block;"></span>
              <span style={`font-family: ${MONO}; font-size: 12px; color: #8fb8a2;`}>01 · READ-ONLY</span>
            </div>
            <h3 style={`font-family: ${DISPLAY}; font-size: 20px; margin: 0 0 8px;`}>Inspect</h3>
            <p style="margin: 0; font-size: 14.5px; color: #9fb0a5;">Reads your codebase, docs, and tickets through access you grant — building a real map of how the business runs.</p>
          </div>
          <div class="dsx-arrow" style="display: flex; align-items: center; justify-content: center; color: #4a5f53; font-size: 22px;">→</div>
          <div style="background: #131e17; border: 1px solid #4a3d1f; border-radius: 12px; padding: 28px;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
              <span style="width: 10px; height: 10px; background: #e2b45a; border-radius: 2px; display: inline-block;"></span>
              <span style={`font-family: ${MONO}; font-size: 12px; color: #e2b45a;`}>02 · YOU DECIDE</span>
            </div>
            <h3 style={`font-family: ${DISPLAY}; font-size: 20px; margin: 0 0 8px;`}>Propose</h3>
            <p style="margin: 0; font-size: 14.5px; color: #9fb0a5;">Briefs you before touching anything: what to build, what it costs, what could break. Nothing ships without your word.</p>
          </div>
          <div class="dsx-arrow" style="display: flex; align-items: center; justify-content: center; color: #4a5f53; font-size: 22px;">→</div>
          <div style="background: #131e17; border: 1px solid #2b5a41; border-radius: 12px; padding: 28px;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
              <span style="width: 10px; height: 10px; background: #2f9e69; border-radius: 2px; display: inline-block;"></span>
              <span style={`font-family: ${MONO}; font-size: 12px; color: #57c78f;`}>03 · ON COMMAND</span>
            </div>
            <h3 style={`font-family: ${DISPLAY}; font-size: 20px; margin: 0 0 8px;`}>Implement</h3>
            <p style="margin: 0; font-size: 14.5px; color: #9fb0a5;">Approve and it executes — reviewable pull requests inside your workflow, every action logged.</p>
          </div>
        </div>
        <div style={`display: flex; align-items: center; gap: 12px; font-family: ${MONO}; font-size: 12px; color: #57695f;`}>
          <span style="flex: 1; border-bottom: 1px dashed #2b3a31;"></span>
          <span>↺ the loop repeats — each pass earns more trust</span>
          <span style="flex: 1; border-bottom: 1px dashed #2b3a31;"></span>
        </div>
      </div>
    </section>

    <!-- COMMAND & CONTROL -->
    <section class="dsx-pad" style="padding: 96px 40px; border-bottom: 1px solid #1f2c24;">
      <div class="dsx-cmd-grid" style="max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;">
        <div>
          <div style={`font-family: ${MONO}; font-size: 12px; color: #57c78f; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 12px;`}>04 / Command &amp; control</div>
          <h2 style={`font-family: ${DISPLAY}; font-size: 42px; letter-spacing: -0.02em; font-weight: 700; margin: 0 0 16px;`}>Autonomy you can pull back.</h2>
          <p style="color: #9fb0a5; margin: 0 0 32px;">The differentiator isn’t capability — it’s that you stay in command of everything the agent can reach and everything it does.</p>
          <div class="dsx-cmd-controls" style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
            <div style="border: 1px solid #26332b; border-radius: 10px; padding: 16px 18px; background: #131e17;"><strong style={`font-family: ${DISPLAY};`}>Scoped</strong><div style="font-size: 13.5px; color: #9fb0a5;">Access granted and bounded — never standing.</div></div>
            <div style="border: 1px solid #26332b; border-radius: 10px; padding: 16px 18px; background: #131e17;"><strong style={`font-family: ${DISPLAY};`}>Audited</strong><div style="font-size: 13.5px; color: #9fb0a5;">Every action logged and attributable.</div></div>
            <div style="border: 1px solid #26332b; border-radius: 10px; padding: 16px 18px; background: #131e17;"><strong style={`font-family: ${DISPLAY};`}>Gated</strong><div style="font-size: 13.5px; color: #9fb0a5;">Consequential steps wait for your sign-off.</div></div>
            <div style="border: 1px solid #26332b; border-radius: 10px; padding: 16px 18px; background: #131e17;"><strong style={`font-family: ${DISPLAY};`}>Revocable</strong><div style="font-size: 13.5px; color: #9fb0a5;">Off the ground in one click — no residue.</div></div>
          </div>
        </div>
        <div style="background: #131e17; border: 1px solid #26332b; border-radius: 14px; box-shadow: 0 20px 50px rgba(0,0,0,0.4); overflow: hidden;">
          <div style="padding: 16px 22px; border-bottom: 1px solid #1f2c24; display: flex; align-items: center; justify-content: space-between;">
            <span style={`font-family: ${MONO}; font-size: 12px; color: #6e8377;`}>Brief #128 · agent/invoice-ops</span>
            <span style="font-size: 12px; font-weight: 600; color: #e2b45a; background: #2a2415; border-radius: 999px; padding: 4px 12px;">Awaiting approval</span>
          </div>
          <div style="padding: 22px;">
            <h3 style={`font-family: ${DISPLAY}; font-size: 18px; margin: 0 0 8px;`}>Reconcile duplicate vendor records</h3>
            <p style="font-size: 14px; color: #9fb0a5; margin: 0 0 18px;">Merge 17 duplicate vendors in NetSuite. Estimated 2h/week saved in AP triage. Risk: low — all merges reversible.</p>
            <div style="display: flex; flex-direction: column; gap: 8px; font-size: 13.5px; margin-bottom: 20px;">
              <div style="display: flex; gap: 10px;"><span style="color: #57c78f;">✓</span> Scope: NetSuite vendor table, read + merge</div>
              <div style="display: flex; gap: 10px;"><span style="color: #57c78f;">✓</span> Rollback plan attached</div>
              <div style="display: flex; gap: 10px;"><span style="color: #57c78f;">✓</span> Guardrails passed 4/4 checks</div>
            </div>
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
              <span style="background: #2f9e69; color: #08130c; padding: 10px 20px; border-radius: 7px; font-size: 14px; font-weight: 600;">Approve &amp; implement</span>
              <span style="border: 1px solid #3a4a40; color: #9fada4; padding: 10px 20px; border-radius: 7px; font-size: 14px; font-weight: 500;">Request changes</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how" class="dsx-pad" style="padding: 96px 40px; border-bottom: 1px solid #1f2c24; background: #0b110d;">
      <div style="max-width: 860px; margin: 0 auto;">
        <div style={`font-family: ${MONO}; font-size: 12px; color: #57c78f; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 12px;`}>05 / How it works</div>
        <h2 style={`font-family: ${DISPLAY}; font-size: 42px; letter-spacing: -0.02em; font-weight: 700; margin: 0 0 44px;`}>Engineered, not prompted.</h2>
        <div style="display: flex; flex-direction: column;">
          {hows.map((h) => (
            <div class="dsx-how-row" style="display: grid; grid-template-columns: 56px 240px 1fr; gap: 24px; padding: 22px 0; border-top: 1px solid #1f2c24; align-items: baseline;">
              <div style={`font-family: ${MONO}; font-size: 13px; color: #57695f;`}>{h.num}</div>
              <div style={`font-family: ${DISPLAY}; font-weight: 600; font-size: 16px;`}>{h.title}</div>
              <div style="font-size: 14.5px; color: #9fb0a5;">{h.body}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="dsx-pad" style="padding: 96px 40px; border-bottom: 1px solid #1f2c24;">
      <div style="max-width: 860px; margin: 0 auto;">
        <div style={`font-family: ${MONO}; font-size: 12px; color: #57c78f; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 12px;`}>06 / Questions</div>
        <h2 style={`font-family: ${DISPLAY}; font-size: 42px; letter-spacing: -0.02em; font-weight: 700; margin: 0 0 36px;`}>Asked before every deployment.</h2>
        <div style="display: flex; flex-direction: column;">
          {faqs.map((q) => (
            <div class="dsx-faq-row" style="border-top: 1px solid #1f2c24; padding: 20px 0; display: grid; grid-template-columns: 1fr 1.4fr; gap: 32px;">
              <div style={`font-family: ${DISPLAY}; font-weight: 600; font-size: 16px;`}>{q.q}</div>
              <div style="font-size: 14.5px; color: #9fb0a5;">{q.a}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="cta" class="dsx-pad" style="padding: 96px 40px; background: radial-gradient(700px 400px at 50% 120%, #16241c 0%, #0f1712 70%);">
      <div style="max-width: 720px; margin: 0 auto; text-align: center;">
        <h2 style={`font-family: ${DISPLAY}; font-size: 44px; letter-spacing: -0.02em; font-weight: 700; margin: 0 0 14px; text-wrap: balance;`}>Give one agent a bounded piece of ground.</h2>
        <p style="color: #9fb0a5; margin: 0 0 32px;">Bring a real problem and a scope you’re comfortable granting. We help you build and deploy it — you decide what ships. Reply within one business day.</p>
        <a href="mailto:command@forward.army" class="dsx-btn" style="display: inline-block; background: #2f9e69; color: #08130c; padding: 14px 32px; border-radius: 7px; font-weight: 600; font-size: 15px;">Request access</a>
      </div>
    </section>
    </main>

    <!-- FOOTER -->
